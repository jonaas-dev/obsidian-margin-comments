{
	"name": "obsidian-margin-comments",
	"version": "1.0.2",
	"description": "Add inline comments to your Obsidian notes with threaded replies, resolve/unresolve, and a sidebar panel.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tests",
		"lint": "eslint src tests --max-warnings 0",
		"format:check": "prettier --check \"{src,tests}/**/*.ts\"",
		"format": "prettier --write \"{src,tests}/**/*.ts\"",
		"test": "vitest run",
		"badges": "node ops/badges.mjs",
		"test:coverage": "vitest run --config vitest.coverage.config.ts",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"sonar": "npm run test:coverage && sh ops/sonar.sh",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "MIT",
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "npm@11.0.0",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"@vitest/coverage-v8": "5.0.5",
		"esbuild": "^0.28.1",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"obsidian": "1.14.4",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"typescript": "^5.7.0",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"minimatch": {
			"brace-expansion": "^5.0.12"
		},
		"source-map-js": "^1.2.2",
		"moment": "^2.31.0"
	}
}
