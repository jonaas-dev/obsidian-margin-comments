# Matches .prettierrc, which is the source of truth; this is for editors that do
# not read it. CI enforces the Prettier settings (npm run format:check), not these.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

# The one file that disagrees with the rest. Recorded rather than silently
# overwritten: Prettier does not format JSON here, so an editor switching it to
# tabs would make a diff out of nothing.
[tsconfig.json]
indent_style = space
indent_size = 2
