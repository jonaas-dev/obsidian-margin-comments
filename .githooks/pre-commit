#!/usr/bin/env sh
# Blocks a commit that would leak a secret, personal data, or the wrong committer
# identity. This repo goes public at 1.0 with its whole history, so anything that
# lands here is permanent.
#
# Install:  sh ops/install-hooks.sh
set -eu

root=$(git rev-parse --show-toplevel)

# The maintainer's commits must carry the GitHub noreply address and the GitHub
# username, never a real name or inbox. Outside contributors are not held to this.
expected_name=$(git config hooks.expectedName 2>/dev/null || echo "jonaas-dev")
actual_name=$(git config user.name 2>/dev/null || echo "")
# Set in the maintainer's clone by `sh ops/install-hooks.sh --maintainer`. Deciding
# from user.name alone skipped the one commit this check exists for: the real name
# and inbox a machine's global git config supplies (#251).
maintainer=$(git config --bool hooks.maintainer 2>/dev/null || echo false)

if [ "$maintainer" = "true" ] || [ "$actual_name" = "$expected_name" ]; then
    if [ "$actual_name" != "$expected_name" ]; then
        printf '\n\033[31m✖ pre-commit: maintainer committer name\033[0m\n\n' >&2
        printf "  user.name is '%s', expected '%s'.\n\n" "${actual_name:-<unset>}" "$expected_name" >&2
        printf '  Fix:  git config user.name "%s"\n\n' "$expected_name" >&2
        exit 1
    fi

    expected_email=$(git config hooks.expectedEmail 2>/dev/null || echo "100514206+jonaas-dev@users.noreply.github.com")
    actual_email=$(git config user.email 2>/dev/null || echo "")

    if [ "$actual_email" != "$expected_email" ]; then
        printf '\n\033[31m✖ pre-commit: maintainer committer identity\033[0m\n\n' >&2
        printf "  user.email is '%s', expected '%s'.\n\n" "${actual_email:-<unset>}" "$expected_email" >&2
        printf '  Fix:  git config user.email "%s"\n\n' "$expected_email" >&2
        exit 1
    fi
fi

python3 "$root/ops/check-secrets.py" || exit 1

# Decision records (ADR). The checker lives in the maintainer's jonas-skills clone,
# so where it is absent (CI, outside contributors) the step says so and moves on.
# It only runs when the staged change touches what it reads.
if git diff --cached --name-only | grep -Eq '^(docs/decisions/|AGENTS\.md$)'; then
    adr_check="${JONAS_SKILLS:-$HOME/Repos/jonas-skills}/scripts/decisions_check.py"
    if [ -f "$adr_check" ]; then
        (cd "$root" && python3 "$adr_check" --dir docs/decisions --agents-md AGENTS.md) || exit 1
    else
        echo "pre-commit: ADR check skipped, $adr_check not found" >&2
    fi
fi
