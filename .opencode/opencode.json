{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": [
        "uvx",
        "code-review-graph",
        "serve"
      ],
      "enabled": true
    },
    "sonarqube": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--init",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_URL",
        "-e",
        "SONARQUBE_TOKEN",
        "mcp/sonarqube"
      ],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "SONARQUBE_URL": "http://host.docker.internal:9000",
        "SONARQUBE_TOKEN": "{file:~/.config/secrets/sonarqube-token}"
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  "permission": {
    "code-review-graph_*": "deny",
    "sonarqube_*": "deny"
  },
  "agent": {
    "repo-auditor": {
      "permission": {
        "code-review-graph_*": "allow",
        "sonarqube_*": "allow"
      }
    },
    "issue-executor": {
      "permission": {
        "code-review-graph_*": "allow",
        "sonarqube_*": "allow"
      }
    },
    "issue-executor-complex": {
      "permission": {
        "code-review-graph_*": "allow",
        "sonarqube_*": "allow"
      }
    },
    "pr-reviewer": {
      "permission": {
        "code-review-graph_*": "allow",
        "sonarqube_*": "allow"
      }
    },
    "debugger": {
      "permission": {
        "code-review-graph_*": "allow",
        "sonarqube_*": "allow"
      }
    },
    "git-flow-helper": {
      "permission": {
        "code-review-graph_*": "allow",
        "sonarqube_*": "allow"
      }
    }
  }
}
