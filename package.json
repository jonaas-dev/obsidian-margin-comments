{
	"name": "obsidian-margin-comments",
	"version": "0.1.0",
	"description": "Add inline comments to your Obsidian notes with threaded replies, resolve/unresolve, and a sidebar panel.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src tests",
		"format": "prettier --write \"{src,tests}/**/*.ts\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.10.0",
		"@typescript-eslint/eslint-plugin": "^8.18.0",
		"@typescript-eslint/parser": "^8.18.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.28.1",
		"eslint": "^9.17.0",
		"globals": "^17.12.0",
		"obsidian": "latest",
		"playwright": "^1.63.0",
		"prettier": "^3.4.0",
		"typescript": "^5.7.0",
		"vitest": "^4.1.11"
	}
}
