{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowJs": true,
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // ES2019.Object for Object.fromEntries, which every Obsidian at minAppVersion
    // ships; it typechecked only because @types/node declared it (#346).
    "lib": ["DOM", "ES2018", "ES2019.Object"],
    "types": []
  },
  "include": ["src/**/*.ts"]
}
